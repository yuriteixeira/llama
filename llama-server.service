[Unit]
Description=Llama.cpp Local LLM Server
Documentation=https://github.com/spiritbuun/buun-llama-cpp
After=network-online.target gpu.service
Wants=network-online.target

[Service]
Type=simple

# Working directory
WorkingDirectory=/home/yuriteixeira/Workspaces/local/services/llama

# The router process; per-model arguments live in versions/buun/model-presets.ini
ExecStart=/home/yuriteixeira/Workspaces/local/services/llama/versions/buun/src/build/bin/llama-server \
  --host 0.0.0.0 \
  --port 8080 \
  --models-preset ./model-presets.ini \
  --models-max 1 \
  --parallel 1 \
  --device CUDA0 \
  --metrics

# REMOVED PARAMS (put them back if needed)
# --verbose \
# --threads-http 4 \

# Restart policy
Restart=always
RestartSec=10

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server

# Security hardening
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
